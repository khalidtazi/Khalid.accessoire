<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Khalid Accessoire - </title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <h1 class="logo">khalid accessoire</h1>
      <nav>
        <a href="index.html">Accueil</a>
        <a href="product.html">Produits</a>
        <a href="faq.html">FAQ</a>
        <a href="contact.html">Contact</a>
        <button id="cart-btn" class="cart-btn">Panier (<span id="cart-count">0</span>)</button>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero container">
      <div>
        <h2>Bienvenue sur khalid accessoires</h2>
        <p>Votre boutique d’accessoires pour hommes & femmes. Qualité, style et prix abordables 💎</p>
        <a class="btn" href="product.html">Découvrir</a>
      </div>
      <div class="hero-img">
        <img src="https://images.unsplash.com/photo-1512496015851-a90fb38ba796?auto=format&fit=crop&w=800&q=60" alt="accessoires">
      </div>
    </section>

    <section class="products container">
      <h3>Nos produits populaires</h3>
      <div class="grid">
        <article class="card">
          <img src="https://images.unsplash.com/photo-1585386959984-a41552205e30?auto=format&fit=crop&w=600&q=60" alt="AirPods">
          <h4></h4>
          <p class="price">149 DH</p>
          <a class="btn" href="product.html">Voir</a>
        </article>
        <article class="card">
          <img src="https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=600&q=60" alt="Casque">
          <h4></h4>
          <p class="price">249 DH</p>
          <a class="btn" href="product.html">Voir</a>
        </article>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container">
      <p>&copy; 2025 khalid accessoires — Tous droits réservés.</p>
    </div>
  </footer>

  <script src="script.js"></script>
</body>
</html>